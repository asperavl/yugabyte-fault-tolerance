# YugabyteDB Image (Pinned version - do not use latest)
YB_IMAGE=yugabytedb/yugabyte:2024.1.3.0-b105

# Database Credentials
DB_USER=yugabyte
DB_PASSWORD=
DB_NAME=yugabyte

# YSQL Client Ports
YB1_YSQL_PORT=5433
YB2_YSQL_PORT=5434
YB3_YSQL_PORT=5435

# Admin / Master Web UI Ports (maps to container port 7000)
YB1_UI_PORT=7001
YB2_UI_PORT=7002
YB3_UI_PORT=7003

# Tablet Server Web UI Ports (maps to container port 9000)
YB1_TSERVER_PORT=9001
YB2_TSERVER_PORT=9002
YB3_TSERVER_PORT=9003

# Experiment Workload Configuration
TARGET_RATE_OPS=50
EXPERIMENT_DURATION_SEC=180
READ_RATIO=0.7
FAILURE_TIME_SEC=60
RECOVERY_TIME_SEC=120

